# ============================================================
#  SeeV Backend — Environment Configuration Example
#  Copy this file to .env and fill in your actual values.
# ============================================================

# ----- Server -----------------------------------------------
PORT=5000
NODE_ENV=development

# ----- Supabase (New Connection) ----------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-DO-NOT-EXPOSE

# ----- BOP (Bank of Palestine / Mastercard MPGS) -----------
BOP_MERCHANT_ID=your_merchant_id
BOP_API_PASSWORD=your_api_password
BOP_WEBHOOK_SECRET=your_webhook_secret

# ----- Frontend (for CORS & redirect URLs) ------------------
CLIENT_URL=http://localhost:5173

# ----- Email (Nodemailer) -----------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=SeeV Platform <your_email@gmail.com>
